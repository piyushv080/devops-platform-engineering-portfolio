<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Repeated work opportunity report</title>
  <style>
    :root{font-family:system-ui,sans-serif;color:#172033;background:#f3f6fb}body{max-width:1100px;margin:2rem auto;padding:0 1rem}
    h1{margin-bottom:.25rem}.muted{color:#58677d}.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(145px,1fr));gap:.8rem;margin:1.4rem 0}
    .card,section{background:#fff;border:1px solid #d8e0ec;border-radius:10px;padding:1rem}.value{font-size:1.6rem;font-weight:700}section{margin:1rem 0;overflow-x:auto}
    table{width:100%;border-collapse:collapse}th,td{text-align:left;padding:.6rem;border-bottom:1px solid #e5eaf1}th{background:#f7f9fc}
  </style>
</head>
<body>
  <h1>Repeated-work opportunities</h1>
  <p class="muted">ServiceNow work from the last {{ opportunity_result.overall.window_days }} days</p>
  <div class="cards">
    <div class="card"><div class="muted">Rows analyzed</div><div class="value">{{ opportunity_result.overall.tasks }}</div></div>
    <div class="card"><div class="muted">Work types</div><div class="value">{{ opportunity_result.overall.types }}</div></div>
    <div class="card"><div class="muted">Automation candidates</div><div class="value">{{ opportunity_result.overall.candidate_types }}</div></div>
    <div class="card"><div class="muted">Handled by people</div><div class="value">{{ opportunity_result.overall.closed_by_people }}</div></div>
    <div class="card"><div class="muted">Estimated hours/month</div><div class="value">{{ opportunity_result.overall.hours_per_month }}</div></div>
  </div>
  <section><h2>Candidate work types</h2><table><thead><tr><th>Work type</th><th>Requests</th><th>Closed by people</th><th>Automation share</th><th>Median close hours</th><th>Estimated people hours/month</th></tr></thead><tbody>
  {% for row in opportunity_result.candidates %}<tr><td>{{ row.type | e }}</td><td>{{ row.requests }}</td><td>{{ row.by_people }}</td><td>{{ row.automation_percent | default('N/A', true) }}{% if row.automation_percent is not none %}%{% endif %}</td><td>{{ row.median_hours_to_close | default('N/A', true) }}</td><td>{{ row.people_hours_per_month | default('N/A', true) }}</td></tr>{% else %}<tr><td colspan="6">No candidate met the configured volume and classification rules.</td></tr>{% endfor %}
  </tbody></table></section>
  <section><h2>Already automated work types</h2><ul>{% for row in opportunity_result.automated %}<li>{{ row.type | e }} — {{ row.requests }} requests</li>{% else %}<li>No automated work types identified in this period.</li>{% endfor %}</ul></section>
  <p class="muted">This report identifies candidates only; it does not create or deploy automations.</p>
</body></html>
