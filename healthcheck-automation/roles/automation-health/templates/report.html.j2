<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Automation health report</title>
  <style>
    :root{font-family:system-ui,sans-serif;color:#172033;background:#f3f6fb}body{max-width:1100px;margin:2rem auto;padding:0 1rem}
    h1{margin-bottom:.25rem}.muted{color:#58677d}.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(145px,1fr));gap:.8rem;margin:1.4rem 0}
    .card,section{background:#fff;border:1px solid #d8e0ec;border-radius:10px;padding:1rem}.value{font-size:1.6rem;font-weight:700}section{margin:1rem 0;overflow-x:auto}
    table{width:100%;border-collapse:collapse}th,td{text-align:left;padding:.6rem;border-bottom:1px solid #e5eaf1}th{background:#f7f9fc}
  </style>
</head>
<body>
  <h1>Automation health</h1>
  <p class="muted">Last {{ automation_health_result.overall.window_days }} days · As of {{ automation_health_result.overall.as_of | e }}</p>
  <div class="cards">
    <div class="card"><div class="muted">Completed jobs</div><div class="value">{{ automation_health_result.overall.runs }}</div></div>
    <div class="card"><div class="muted">Successful</div><div class="value">{{ automation_health_result.overall.successful }}</div></div>
    <div class="card"><div class="muted">Failed</div><div class="value">{{ automation_health_result.overall.failed }}</div></div>
    <div class="card"><div class="muted">Success rate</div><div class="value">{{ automation_health_result.overall.success_rate | default('N/A', true) }}{% if automation_health_result.overall.success_rate is not none %}%{% endif %}</div></div>
    <div class="card"><div class="muted">Hours saved (estimate)</div><div class="value">{{ automation_health_result.overall.hours_saved }}</div></div>
  </div>
  <section><h2>Template results</h2><table><thead><tr><th>Template</th><th>Runs</th><th>Success</th><th>Failed</th><th>Success rate</th><th>Median seconds</th><th>Last status</th></tr></thead><tbody>
  {% for row in automation_health_result.templates %}<tr><td>{{ row.name | e }}</td><td>{{ row.runs }}</td><td>{{ row.successful }}</td><td>{{ row.failed }}</td><td>{{ row.success_rate | default('N/A', true) }}{% if row.success_rate is not none %}%{% endif %}</td><td>{{ row.median_runtime_s | default('N/A', true) }}</td><td>{{ row.last_status | default('No runs', true) | e }}</td></tr>{% else %}<tr><td colspan="7">No matching template runs in this period.</td></tr>{% endfor %}
  </tbody></table></section>
  <section><h2>Frequent failure reasons</h2><table><thead><tr><th>Reason</th><th>Count</th></tr></thead><tbody>
  {% for item in automation_health_result.failure_reasons %}<tr><td>{{ item.reason | e }}</td><td>{{ item.count }}</td></tr>{% else %}<tr><td colspan="2">No failed jobs found.</td></tr>{% endfor %}
  </tbody></table></section>
  <section><h2>Templates not run</h2><ul>{% for name in automation_health_result.not_run %}<li>{{ name | e }}</li>{% else %}<li>All discovered templates ran during the period.</li>{% endfor %}</ul></section>
</body></html>
